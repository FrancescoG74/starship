; Engine configuration file.
; Regenerated by Godot when the project is opened in the editor.

config_version=5

[application]

config/name="Starship"
config/description="A Jolt Physics powered starship that takes off from a runway."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

starship_pitch_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventKey,"device":-1,"physical_keycode":4194322)]
}
starship_pitch_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventKey,"device":-1,"physical_keycode":4194320)]
}
starship_roll_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventKey,"device":-1,"physical_keycode":4194319)]
}
starship_roll_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventKey,"device":-1,"physical_keycode":4194321)]
}
starship_yaw_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81)]
}
starship_yaw_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69)]
}
starship_throttle_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)]
}
starship_throttle_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194326)]
}
starship_brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":66)]
}
starship_reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82)]
}

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
